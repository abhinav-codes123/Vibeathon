# Optional advisory AI. Leave blank to use the deterministic local engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Used to resolve Open Graph and Twitter images to absolute URLs.
NEXT_PUBLIC_SITE_URL=https://flowdine-ai.abhinavchaudhary484.chatgpt.site

# Supabase Auth. The publishable key is safe for the browser; the service-role
# key is server-only and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional future server-side invitation administration. Not used by current auth flows.
SUPABASE_SERVICE_ROLE_KEY=
